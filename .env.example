# MongoDB Credentials
DB_USER=your_mongodb_username
DB_PASS=your_mongodb_password

# JWT Token Secret
ACCESS_TOKEN_SECRET=your_super_secret_jwt_key_32_characters

# Stripe Secret Key (for card payments)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
# Alternative key name for backwards compatibility
STRIP_SECRET_KEY=sk_test_your_stripe_secret_key

# Port (Optional, default 9000 for local dev)
PORT=9000
